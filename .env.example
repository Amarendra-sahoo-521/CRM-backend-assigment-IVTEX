# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas (replace user, password and cluster; keep the /crm database name)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/crm?retryWrites=true&w=majority

# JWT (use two different long random strings)
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGIN=http://localhost:3000